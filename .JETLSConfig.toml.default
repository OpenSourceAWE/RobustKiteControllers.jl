# The example scripts open with a docstring of the whole script, followed by a blank line.
[[diagnostic.patterns]]
pattern = "lowering/orphaned-docstring"
match_by = "code"
match_type = "literal"
severity = "off"
path = "examples/**/*.jl"

# No inferred-type inlay hints in the editor; the `end`-tag hints stay.
[inlay_hint.types]
enabled = false
