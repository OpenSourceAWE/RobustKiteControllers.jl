/Manifest*.toml
/examples/Manifest.toml
# Stale manifests that bin/install moved aside.
Manifest*.toml.bak
.vscode/settings.json
# Generated by bin/create_sys_image.
/bin/*.so
/bin/*.so.bak
# V3Kite's generated artifacts used to be redirected here by `cache_path`; they now
# stay in V3Kite's own cache directory. Ignored so leftovers do not show up.
/examples/cache/
# Arrow logs written by simple_fig8.jl, named after the project's log_file setting.
/output/
# Session state written by the examples/select_*.jl menus; data/gui.yaml.default is the template.
/data/gui.yaml
# JETLS settings; bin/install copies .JETLSConfig.toml.default here.
/.JETLSConfig.toml
# Mann wind fields generated by AtmosphericModels when use_turbulence > 0; ~1.2 GB each.
/data/windfield_*.npz
.markdownlint.json
trajectories/
notebooks/images/

# Per-machine Claude Code permissions; .claude/skills/ is checked in.
/.claude/settings.local.json
docs/.$flight_path_controller.drawio.bkp
docs/.$flight_path_controller2.drawio.bkp
test/Manifest.toml
docs/.$course_loop_model.drawio.bkp
